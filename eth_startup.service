[Unit]
Description=Start Ethernet Interface and Obtain IP Address
After=network.target

# You can change the name of the ethernet Interface to your liking by changing /etc/udev/rules.d/10-local-net.rules
[Service]
Type=oneshot
ExecStart=/bin/bash -c "ip link set eth1 up && dhclient eth1"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target